rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Single Administrator Authorization Boundary
    // =========================================================================
    // Exclusively restricted to the single designated administrator UID.
    // Custom claims and user self-assignment are strictly disallowed.
    function isAdmin() {
      return request.auth != null &&
          request.auth.uid == 'p6awFfdX9jRKAScGwvSU9OMXjm72';
    }

    // =========================================================================
    // 1. CMS Drafts Collection (Admin Only - Zero Public Access)
    // =========================================================================
    // Contains working drafts, unpublished items, and staging revisions.
    // Public users have NO read or write access under any circumstances.
    match /cms_drafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 2. Public Website Content Collections
    // =========================================================================
    // Public visitors can only read published documents.
    // Only the authorized admin can create, update, or delete content.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_sections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. Admissions Enquiries Collection (Hardened Security)
    // =========================================================================
    // Helper function for strict enquiry submission schema validation
    function isValidEnquiryPayload(phone) {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'id', 'name', 'phone', 'program', 'message', 'status',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasAll(['name', 'phone', 'program', 'message', 'status']) &&
      data.phone == phone &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
      data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15 &&
      data.program is string && data.program.size() >= 1 && data.program.size() <= 100 &&
      data.message is string && data.message.size() <= 500 &&
      data.status is bool && data.status == true &&
      (!('id' in data) || data.id is string) &&
      (!('createdAt' in data) || data.createdAt is timestamp) &&
      (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /enquiries/{phone} {
      // Confidential personal data: Restricted strictly to verified administrator
      allow get, list: if isAdmin();

      // Creation: Verified admin OR public/authenticated submission meeting strict schema
      allow create: if isAdmin() || isValidEnquiryPayload(phone);

      // Updates and deletions: Exclusively restricted to verified administrator
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
